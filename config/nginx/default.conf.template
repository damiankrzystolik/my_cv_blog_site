# Domenę podstawia entrypoint obrazu nginx ze zmiennej DOMAIN (.env)

# Bez wersji nginx w nagłówku Server i na stronach błędów
server_tokens off;

server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    return 444;
}

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};
    client_max_body_size 50M;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${DOMAIN} www.${DOMAIN};
    client_max_body_size 50M;

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Adres `web` rozwiązywany przez DNS Dockera przy każdym żądaniu (zmienna w uwsgi_pass).
    # Statyczne `uwsgi_pass web:8000` zapamiętuje IP przy starcie nginx — po odtworzeniu
    # kontenera web (prod-up po zmianie .env, prod-deploy) dawało 502 "No route to host".
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $web_upstream web:8000;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript;

    location /static/ {
        alias /app/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /media/ {
        alias /app/media/;
        expires 7d;
        add_header X-Content-Type-Options nosniff;
    }

    # Health check tylko z wnętrza kontenera nginx (uWSGI mówi protokołem uwsgi, nie HTTP,
    # więc inaczej się do niego nie dobijesz). Z internetu 403.
    location /health/ {
        allow 127.0.0.1;
        deny all;
        include uwsgi_params;
        uwsgi_param HTTP_X_REAL_IP $remote_addr;
        uwsgi_param HTTP_X_FORWARDED_PROTO $scheme;
        uwsgi_pass $web_upstream;
        access_log off;
    }

    location / {
        include uwsgi_params;
        uwsgi_param HTTP_X_REAL_IP $remote_addr;
        uwsgi_param HTTP_X_FORWARDED_PROTO $scheme;
        uwsgi_pass $web_upstream;
    }
}
