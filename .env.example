SECRET_KEY=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DJANGO_SETTINGS_MODULE=config.settings.development

# --- Produkcja ---
# Domena bez https:// i www, np. example.com (nginx)
DOMAIN=
# Np. example.com,www.example.com
ALLOWED_HOSTS=
# Np. https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SENTRY_DSN=
# Ścieżka panelu admina; tylko redukcja szumu od botów, nie zabezpieczenie
ADMIN_URL=admin/
GRAFANA_ADMIN_PASSWORD=

# --- Poczta (powiadomienia o komentarzach) ---
# Bez EMAIL_HOST maile lądują w logach (console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
# Adresy oddzielone przecinkami
BLOG_COMMENT_NOTIFY_EMAILS=
